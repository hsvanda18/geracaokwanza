# Copy this file to .env.local and fill in the values from your Sanity project
# (Project settings → API, at sanity.io/manage).

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed to run `npm run seed` (scripts/seed-sanity.mjs). Create an
# "Editor" token at sanity.io/manage → your project → API → Tokens.
# Never commit this — write access to your content.
SANITY_API_WRITE_TOKEN=
